# Copy to .env.local and fill in. Every value is OPTIONAL:
# - With NO values set, the app runs as a local-only PWA (localStorage + seed
#   feedback) — exactly the Phase 0 experience.
# - Add the Supabase pair to turn on cloud sync + auth (Phase 1).
# - Add an LLM below to turn on personalised feedback/explanations/corrections.

# ---- Phase 1: Supabase (client-visible; safe to expose the anon key) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Phase 2: LLM (SERVER ONLY — never prefix these with NEXT_PUBLIC) ----
# Pick ONE provider.
#
# Option A — Anthropic (default):
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_MODEL=claude-sonnet-5        # or claude-haiku-4-5-20251001 (cheaper)
#
# Option B — any OpenAI-compatible API (DeepSeek / xAI Grok / NVIDIA Nemotron / …):
#   LLM_PROVIDER=openai
#   LLM_API_KEY=<your key>
#   LLM_BASE_URL=<see below>
#   LLM_MODEL=<see below>
#
#   DeepSeek : LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
#   xAI Grok : LLM_BASE_URL=https://api.x.ai/v1               LLM_MODEL=grok-3-mini
#   Nemotron : LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#              LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
#   (Model ids move — confirm the current name in the provider's console.)

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-5
