# Copy to .env.local and fill in. Every value is OPTIONAL:
# - With NO values set, the app runs as a local-only PWA (localStorage + seed
#   feedback) — exactly the Phase 0 experience.
# - Add the Supabase pair to turn on cloud sync + auth (Phase 1).
# - Add the LLM key to turn on personalised feedback/explanations (Phase 2).

# ---- Phase 1: Supabase (client-visible; safe to expose the anon key) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Phase 2: LLM (SERVER ONLY — never prefix with NEXT_PUBLIC) ----
# Anthropic API key. Leave blank to keep using seed feedback.
ANTHROPIC_API_KEY=
# Model id (defaults to claude-sonnet-5 when unset).
LLM_MODEL=claude-sonnet-5
